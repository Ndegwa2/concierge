# Production Environment Variables for Render
# IMPORTANT: These values should be set in Render's Environment Variables dashboard

# Server Configuration
PORT=10000
NODE_ENV=production

# Database - PostgreSQL 16
# Primary write connection
DATABASE_URL=postgresql://autoconcierge:your_secure_password_here@localhost:5432/autoconcierge_prod

# Read Replica URL (for read-heavy operations)
DATABASE_READ_URL=postgresql://autoconcierge:your_secure_password_here@localhost:5432/autoconcierge_prod_read

# JWT - Generate a secure random string for production
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=your-secure-jwt-secret-min-32-chars-here
JWT_ACCESS_TOKEN_EXPIRES=86400
JWT_REFRESH_TOKEN_EXPIRES=2592000

# Frontend URL (for CORS)
CORS_ORIGIN=https://your-frontend-app.onrender.com

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Security
SECRET_KEY=your-secret-key-min-32-chars-here
WTF_CSRF_ENABLED=False

# Rate Limiting - Use Redis in production
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Connection Pool Tuning
SQLALCHEMY_ENGINE_OPTIONS={"pool_size": 20, "max_overflow": 0, "pool_timeout": 30, "pool_recycle": 1800}

# Session
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=None
