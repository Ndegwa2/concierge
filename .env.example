# ---------------------------------------------------------------------------
# AutoConcierge Backend — environment template.
#
# Copy to .env (and backend/.env if running the API separately) and fill in
# real values. NEVER commit a real .env — every entry below is a template only.
# In production, prefer setting these through your platform's secret manager
# (Render, Vercel, etc.) rather than shipping a .env file.
#
# NOTE: ENCRYPTION_KEY and the JWT/SECRET keys are REQUIRED outside of
# development mode (the app refuses to start without them).
# Generate a URL-safe key with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------

# --- Flask core -----------------------------------------------------------
# One of: development, testing, production
FLASK_ENV=development

# Session/CSRF signing key (required when FLASK_ENV != development)
SECRET_KEY=

# --- Database -------------------------------------------------------------
# SQLAlchemy connection URL. Use the postgres+psycopg2 scheme in production:
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/autoconcierge

# Optional read replica (leave empty to disable)
DATABASE_READ_URL=

# Conservative connection-pool sizing. Total connections used by the app are
# workers * (DB_POOL_SIZE + DB_MAX_OVERFLOW); keep that under your DB plan cap.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- JWT ------------------------------------------------------------------
# Required when FLASK_ENV != development
JWT_SECRET_KEY=

# Short-lived access tokens (minutes)
JWT_ACCESS_EXPIRES_MINUTES=30

# Long-lived refresh tokens (days)
JWT_REFRESH_EXPIRES_DAYS=7

# --- Encryption / token secrets -------------------------------------------
# Required in production. Used for phone-verification tokens and any
# at-rest encryption of PII.
ENCRYPTION_KEY=

# Pepper applied to phone-verification hash + salt (do NOT reuse SECRET_KEY)
PHONE_TOKEN_PEPPER=

# --- Redis / Celery -------------------------------------------------------
# Broker + result backend for Celery and the rate-limiter (memory:// falls back
# to an in-process limiter useful only for local development).
REDIS_URL=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# Toggle Flask-Limiter (keep enabled in production)
RATELIMIT_ENABLED=true

# --- CORS / proxy ---------------------------------------------------------
# Comma-separated list of allowed frontend origins. Empty => local dev origins.
CORS_ORIGIN=http://localhost:5173

# Set to true when the app runs behind a TLS-terminating proxy (Render, etc.)
BEHIND_PROXY=true

# Set to true to emit HSTS and force HTTPS redirects
ENFORCE_HTTPS=false

# --- Row-Level Security (optional) ---------------------------------------
# Only enable when connected as a non-superuser role with postgresql_setup.sql
# policies installed. Enabling with a superuser connection bypasses every
# policy, which is worse than leaving it off.
ENABLE_RLS=false

# --- File uploads ---------------------------------------------------------
# Directories used for document/signature, proof-of-work and onboarding files.
PROOF_OF_WORK_UPLOAD_FOLDER=backend/uploads/proof_of_work
WELCOME_PACK_DIR=

# --- Email / Onboarding ---------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

ONBOARDING_LEAD_NAME=AutoConcierge Operations Team
ONBOARDING_LEAD_PHONE=Please reply to this email
ONBOARDING_LEAD_EMAIL=
ONBOARDING_LEAD_WHATSAPP=
ONBOARDING_SIGNATORY_NAME=AutoConcierge Team
ONBOARDING_SIGNATORY_TITLE=Concierge Operations
ONBOARDING_SIGNATORY_PHONE=
ONBOARDING_SIGNATORY_EMAIL=
ONBOARDING_WEBSITE=
ONBOARDING_OPERATING_HOURS=Please contact your dedicated concierge lead for current operating hours.
ONBOARDING_EMERGENCY_CONTACT=Contact your dedicated concierge lead or reply to this email for urgent assistance.

# --- Integrations ---------------------------------------------------------
# Google GenAI API key (used for AI chat completions)
GOOGLE_API_KEY=

# M-Pesa Daraja credentials (production/ sandbox)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_INITIATOR_NAME=
MPESA_INITIATOR_PASSWORD=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
