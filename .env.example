# ===========================================================================
# AutoConcierge Docker Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ===========================================================================

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=autoconcierge
POSTGRES_USER=autoconcierge
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_PASSWORD=change-me-to-another-strong-password

# ---------------------------------------------------------------------------
# Flask Backend
# ---------------------------------------------------------------------------
FLASK_ENV=production

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-64-char-hex

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-different-random-64-char-hex

# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-generate-a-32-byte-base64-key

# CORS origin (your frontend URL)
CORS_ORIGIN=https://localhost

# Gunicorn settings
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# ---------------------------------------------------------------------------
# Email (optional - for notifications)
# ---------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------------
# M-Pesa (optional - for payments)
# ---------------------------------------------------------------------------
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Google AI (optional - for AI chat)
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
